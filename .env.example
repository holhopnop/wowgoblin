# Copy to .env. Never commit .env.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://goblin:change-me@db:5432/goblin
# Market IDs use dots, e.g. forever.pvp.horde.eu (EU opens 5 Nov 2026). US beta for testing:
GOBLIN_MARKET=forever.pvp.horde.us
GOBLIN_OPPOSITE_MARKET=forever.pvp.alliance.us
AHLEDGER_API_KEY=
# Contact line sent in User-Agent so AHledger can reach you
GOBLIN_CONTACT=you@example.com
